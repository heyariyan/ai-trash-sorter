[Unit]
Description=AI Trash Sorter Appliance Service
After=network.target local-fs.target

[Service]
Type=simple
User=ariyan
Group=ariyan
WorkingDirectory=/opt/ai-trash-sorter/raspberry-pi
Environment=PYTHONPATH=/opt/ai-trash-sorter/raspberry-pi/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-trash-sorter/raspberry-pi/.venv/bin/python -m main \
    --config /etc/ai-trash-sorter/config.json --confirm-actuators
Restart=always
RestartSec=3
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
